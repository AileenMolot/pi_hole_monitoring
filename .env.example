TZ=Europe/Kyiv

# Bind Grafana, Prometheus, and Alertmanager to localhost by default.
# Use 0.0.0.0 only on a trusted LAN or behind a reverse proxy/VPN.
MONITORING_BIND_ADDRESS=127.0.0.1

# Existing Pi-hole instance to monitor. Do not include protocol here.
PIHOLE_HOSTNAME=192.168.1.10
PIHOLE_PROTOCOL=http
PIHOLE_PORT=80
# Pi-hole v6: create an app password in Settings → Web interface / API →
# Configure app password. (Pi-hole v5: use the API token / WEBPASSWORD.)
PIHOLE_PASSWORD=change-me
PIHOLE_EXPORTER_INTERVAL=30s

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=use-a-long-random-password
GRAFANA_COOKIE_SECURE=false

# Grafana signs sessions with this key. Generate with: openssl rand -base64 32
# Without it Grafana generates a random key at startup, invalidating all sessions on restart.
GRAFANA_SECRET_KEY=change-me-to-a-long-random-string

# Used for absolute links in alert notifications. Set to your Grafana URL.
GRAFANA_ROOT_URL=http://127.0.0.1:3000

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
# Hard cap on metric storage; the oldest data is dropped first when reached.
PROMETHEUS_RETENTION_SIZE=5GB

ALERTMANAGER_PORT=9093

# Signal alert delivery. SIGNAL_NUMBER is the account linked to signal-api
# (international format); SIGNAL_RECIPIENTS is a comma-separated list.
SIGNAL_NUMBER=+380000000000
SIGNAL_RECIPIENTS=+380000000000
# Localhost-only port for the one-time device-linking QR page.
SIGNAL_API_PORT=8080

# Optional dead man's switch: a healthchecks.io (or similar) ping URL.
# Alertmanager's Watchdog heartbeat pings it every 5 minutes.
HEALTHCHECKS_URL=

# Node Exporter uses host networking for accurate host metrics. Binding to the
# docker0 bridge IP keeps it reachable from Prometheus (via host.docker.internal)
# but not from the LAN. Check the IP with: ip -4 addr show docker0
NODE_EXPORTER_LISTEN_ADDRESS=172.17.0.1:9100
